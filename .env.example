# BhodBasha Environment Configuration

# Core App
BHODBASHA_ENV=development
BHODBASHA_SECRET_KEY=bhodbasha_super_secret_jwt_key_for_offline_first_stem_platform_2026
BHODBASHA_DATABASE_URL=sqlite:///./bhodbasha.db
# For PostgreSQL in Docker Compose:
# BHODBASHA_DATABASE_URL=postgresql+asyncpg://bhodbasha_user:bhodbasha_pass@postgres:5432/bhodbasha_db
REDIS_URL=redis://localhost:6379/0

# Demo Mode & Deterministic AI Provider Mocks
MOCK_PROVIDERS=true

# AI Provider Credentials (Optional when MOCK_PROVIDERS=true)
WHISPER_MODEL=base
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
OPENAI_API_KEY=

# Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://demo-bhodbasha.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.demo-anon-key-bhodbasha
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.demo-service-role-key-bhodbasha
SUPABASE_JWT_SECRET=demo-supabase-jwt-secret-bhodbasha

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=BhodBasha
NEXT_PUBLIC_APP_TAGLINE="Knowledge that speaks your language, even offline."
